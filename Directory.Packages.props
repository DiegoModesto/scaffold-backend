<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Static code analysis -->
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.37.0.15768" />
    <!-- Observability (OpenTelemetry) -->
    <PackageVersion Include="OpenTelemetry" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.21.0" />
    <PackageVersion Include="Npgsql.OpenTelemetry" Version="11.0.0" />
    <!-- Application -->
    <PackageVersion Include="Scrutor" Version="7.0.0" />
    <PackageVersion Include="FluentValidation" Version="12.2.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="11.0.0" />
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <!-- Infrastructure -->
    <PackageVersion Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.Redis" Version="9.0.0" />
    <PackageVersion Include="EFCore.NamingConventions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.3.14" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="11.0.0" />
    <!-- Web.API -->
    <PackageVersion Include="AspNetCore.HealthChecks.UI.Client" Version="9.0.0" />
    <PackageVersion Include="Asp.Versioning.Http" Version="10.2.3" />
    <PackageVersion Include="Asp.Versioning.Mvc.ApiExplorer" Version="10.2.1" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="11.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0" />
    <PackageVersion Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <PackageVersion Include="Serilog.AspNetCore" Version="11.0.0" />
    <PackageVersion Include="Serilog.Sinks.Seq" Version="9.2.0" />
    <PackageVersion Include="Swashbuckle.AspNetCore.SwaggerUI" Version="11.0.1" />
    <!-- CronJobs / Worker -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
    <PackageVersion Include="Cronos" Version="0.13.0" />
    <PackageVersion Include="RabbitMQ.Client" Version="7.3.0" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="11.0.0" />
    <PackageVersion Include="Serilog.Settings.Configuration" Version="11.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <!-- Tests -->
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="coverlet.collector" Version="10.1.1" />
    <PackageVersion Include="Moq" Version="4.21.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0" />
    <!-- Identity -->
    <PackageVersion Include="OpenIddict.Abstractions" Version="7.9.0" />
    <PackageVersion Include="OpenIddict.AspNetCore" Version="7.9.0" />
    <PackageVersion Include="OpenIddict.EntityFrameworkCore" Version="7.9.0" />
    <PackageVersion Include="OpenIddict.Validation.AspNetCore" Version="7.9.0" />
    <PackageVersion Include="OpenIddict.Quartz" Version="7.9.0" />
    <PackageVersion Include="Quartz.Extensions.Hosting" Version="4.8.1" />
    <!-- Redis -->
    <PackageVersion Include="StackExchange.Redis" Version="3.4.35" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.StackExchangeRedis" Version="11.0.0" />
    <!-- Tests -->
    <PackageVersion Include="WireMock.Net" Version="2.34.0" />
    <!-- WireMock pulls the Humanizer 2.x metapackage while EF Core 11 pulls Humanizer.Core 3.x; pin the metapackage so all locales match. -->
    <PackageVersion Include="Humanizer" Version="3.0.10" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.17.0" />
    <PackageVersion Include="Testcontainers.Redis" Version="4.17.0" />
    <!-- Blazor BFF -->
    <PackageVersion Include="MudBlazor" Version="9.14.0" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="11.0.0" />
    <!-- BFF tests -->
    <PackageVersion Include="bunit" Version="2.15.2" />
    <!-- Reverse proxy -->
    <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />
    <!-- Identity (gateway-specific) -->
    <PackageVersion Include="OpenIddict.Validation.SystemNetHttp" Version="7.9.0" />
    <!-- SAML -->
    <PackageVersion Include="ITfoxtec.Identity.Saml2" Version="4.22.3" />
    <PackageVersion Include="ITfoxtec.Identity.Saml2.MvcCore" Version="4.22.3" />
    <!--
      ITfoxtec.Identity.Saml2 transitively pulls a newer Microsoft.IdentityModel.*
      than OpenIddict does. The two ranges resolve to a mix
      (e.g. Microsoft.IdentityModel.Tokens from one alongside JsonWebTokens from the other), and
      the resulting binary incompatibility silently breaks reference-token introspection
      (active=false even for fresh tokens). Pinning the whole IdentityModel surface to a
      single version restores a coherent assembly graph.
    -->
    <PackageVersion Include="Microsoft.IdentityModel.Abstractions" Version="8.23.0" />
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Logging" Version="8.23.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Protocols" Version="8.23.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.23.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Tokens" Version="8.23.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Tokens.Saml" Version="8.23.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Xml" Version="8.23.0" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
  </ItemGroup>
</Project>
